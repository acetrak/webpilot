{
  "name": "webpilot",
  "displayName": "WebPilot",
  "version": "0.0.1",
  "description": "WebPilot browser side panel for your local OpenCode server.",
  "author": "WebPilot",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "ts-check": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.25",
    "@base-ui/react": "^1.8.0",
    "@opencode/client": "^2.0.24",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "markdown-it": "^15.0.2",
    "motion": "^14.0.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^17.0.15",
    "rxjs": "^7.8.2",
    "turndown": "^7.2.4",
    "tw-shimmer": "^0.4.13",
    "wouter": "^3.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "5.3.3"
  },
  "manifest": {
    "optional_host_permissions": [
      "http://*/*"
    ],
    "permissions": [
      "activeTab",
      "scripting",
      "sidePanel",
      "declarativeNetRequest",
      "storage"
    ],
    "host_permissions": [
      "https://*/*",
      "http://127.0.0.1/*"
    ]
  }
}
